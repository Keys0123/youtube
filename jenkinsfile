pipeline {
    agent any

    environment {
        DOCKERHUB_USERNAME = "umes122"
        BACKEND_IMAGE = "youtube-backend"
        FRONTEND_IMAGE = "youtube-frontend"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'staging', url: 'https://github.com/Keys0123/youtube.git'
            }
        }

        stage('Build Backend Image') {
            steps {
                dir('server') {
                    sh "docker build -t $DOCKERHUB_USERNAME/$BACKEND_IMAGE:latest ."
                }
            }
        }

        stage('Build Frontend Image') {
            steps {
                dir('client') {
                    sh "docker build -t $DOCKERHUB_USERNAME/$FRONTEND_IMAGE:latest ."
                }
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh "docker login -u $USER -p $PASS"
                }
            }
        }

        stage('Push Images') {
            steps {
                sh "docker push $DOCKERHUB_USERNAME/$BACKEND_IMAGE:latest"
                sh "docker push $DOCKERHUB_USERNAME/$FRONTEND_IMAGE:latest"
            }
        }
    }

    post {
        success {
            echo "CI Pipeline completed successfully"
        }
        failure {
            echo "CI Pipeline failed"
        }
    }
}

